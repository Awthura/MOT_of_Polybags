synth_dataset/
synth_dataset_mcmot/
synth_dataset_test/
synth_dataset_val/
superquadrics_*/
missing_frames_*.txt

# Render outputs and logs (synthetic_polybags/)
render_logs*/
render_logs_mcmot/
render_logs_test/
render_logs_val/

# Dataset/output directories (real_polybags/)
full_dataset/
real_data_labels/
pipeline_output/
pseudo_label/
real_polybags/dataset/annotated/
real_polybags/dataset/unlabelled/
real_polybags/dataset/unlabelled_autolabels/
real_polybags/dataset/unlabelled_autolabels_v4/
# 839MB, ~95% regenerable overlay JPEGs; labels are reproducible from the
# scripts + the round-2 model. Same rationale as the two trees above.
real_polybags/dataset/unlabelled_autolabels_v4_tiled/
real_polybags/training/locate_anything/pilot_sample/
real_polybags/training/locate_anything/checkpoints/
*.cache

# Calibration / review state (local machine-specific)
review_state.json
calibration.json

# Local operational notes (cluster paths/usernames, not shared repo content)
pilot_instructions.md

# YOLO training output
runs/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Calibration boards — these are DELIVERABLES, not generated clutter. The exact
# printed geometry must stay recoverable: a board whose square size or
# dictionary is unknown afterwards is scrap, and reprinting a differently-sized
# board silently invalidates every metric result derived from the old one.
# Overrides the blanket *.png / *.pdf rules above.
!real_polybags/calibration/boards/*.pdf
!real_polybags/calibration/boards/*.png
!real_polybags/calibration/boards/*.json

# Local editor/agent settings backups
.claude/settings.local.json.bak
