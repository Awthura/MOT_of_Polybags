# Images and video
*.png
*.jpg
*.jpeg
*.bmp
*.tiff
*.avi
*.mp4
*.mov

# ...except artefacts that are source, not output: the printed calibration
# boards, and the screenshots PROCEDURE.md renders. Both were previously kept
# only by `git add -f`, which is a step someone eventually forgets.
!real_polybags/calibration/boards/*.png
!real_polybags/calibration/docs/screenshots/*.png

# Binary / large data
*.npy
*.pkl
*.pt
*.pth
*.bin
*.h5
*.hdf5
*.safetensors

# Blender and 3D assets
*.blend
*.blend1
*.stl
*.obj
*.fbx

# PDF (generated from .md sources)
*.pdf

# Tracking outputs — generated files, not source
tracking_results/

